    try:
        refresh_cluster_policy()
    except Exception as exc:
        print(f"BLOCKED: Cluster configuration invalid: {exc}")
        return
    target = target_prompt()
    if not target:
        print("Invalid host.")
        return

    ip = inventory_hosts().get(target, {}).get("ansible_host")

    if ip in CONTROL_IPS:
        print("BLOCKED: HA control-plane node.")
        return

    if not acc_authorize_worker_target(target):
        print("BLOCKED: Unknown worker identity.")
        return

    print("WARNING: This operation does not drain Kubernetes workloads.")
    print("Prefer option 20 for safe worker maintenance.")

    confirmation = f"REBOOT {target} WITHOUT DRAIN"
    if input(f"Type {confirmation}: ").strip() != confirmation:
        print("Cancelled.")
        return

    adhoc(
        target,
        "ansible.builtin.reboot",
        "reboot_timeout=600",
        True,
        True
    )

