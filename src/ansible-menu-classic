    print('\nSAFE WORKER MAINTENANCE (control planes deliberately blocked)')
    target=target_prompt()
    if not target:return
    props=inventory_hosts().get(target,{})
    ip=props.get('ansible_host')
    if ip in CONTROL_IPS:
        print('BLOCKED: control-plane maintenance requires a separate quorum-aware procedure.');return
    if not acc_authorize_worker_target(target):
        print('BLOCKED: unknown worker identity; review inventory first.');return
    bfile=BACKUP_DIR/'backup-status.json'
    try:
        b=json.loads(bfile.read_text());date=datetime.datetime.fromisoformat(b['checked_at'])
        age=(datetime.datetime.now(datetime.timezone.utc)-date).total_seconds()/3600
        if b.get('status')!='OK' or age>36: raise ValueError('No fresh successful backup')
    except (OSError,KeyError,ValueError,TypeError) as e:
        print('BLOCKED: backup status check failed:',e);return
    # The API must confirm full health before any workload movement.
    nodes,error=read_cluster_json(['get','nodes','-o','json'])
    if error:print('BLOCKED:',error);return
    items=nodes.get('items',[])
    if len(items)!=5 or any(not any(x.get('type')=='Ready' and x.get('status')=='True' for x in n.get('status',{}).get('conditions',[])) for n in items):
        print('BLOCKED: Kubernetes does not report five Ready nodes.');return
    print('Preflight: backup fresh; all five Kubernetes nodes Ready.')
    print('NOTE: drain can be blocked by pod disruption budgets or unmanaged pods.')
    print('This workflow updates/reboots one worker; the cluster API is accessed through node1.')
    if input(f'Type MAINTAIN {target} to proceed: ').strip()!=f'MAINTAIN {target}':return
    # Each step checked; if update or reboot fails, leave cordoned for investigation.
    try:foundation=foundation_host()
    except RuntimeError as e:print('BLOCKED:',e);return
    def api(args):
        return run(['ansible',foundation,*BASE,'-b','-K','-m','ansible.builtin.command',
                    '-a','microk8s kubectl '+shlex.join(args)])
    if api(['cordon',target]):print('Failed cordon; stopping.');return
    if api(['drain',target,'--ignore-daemonsets','--delete-emptydir-data','--timeout=180s']):
        print('Drain incomplete; node remains cordoned. Investigate before uncordoning.');return
    print('Drain succeeded. Running package upgrade on',target)
    if adhoc(target,'ansible.builtin.apt','update_cache=yes upgrade=dist',True,True):
        print('Update failure. Node stays cordoned; investigate.');return
    if input(f'Type REBOOT {target} to reboot, otherwise leave cordoned: ').strip()!=f'REBOOT {target}':return
    if adhoc(target,'ansible.builtin.reboot','reboot_timeout=900',True,True):
        print('Reboot failure. Node stays cordoned.');return
    # Kubernetes readiness check before uncordon.
    n,err=read_cluster_json(['get','node',target,'-o','json'])
    if err or not any(c.get('type')=='Ready' and c.get('status')=='True' for c in (n or {}).get('status',{}).get('conditions',[])):
        print('Node readiness not confirmed; node stays cordoned.',err or 'NotReady');return
    if input(f'Node Ready. Type UNCORDON {target} to resume scheduling: ').strip()==f'UNCORDON {target}':
        api(['uncordon',target])
    else:print('Node remains cordoned by choice.')

