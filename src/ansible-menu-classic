def read_cluster_json(command):
    # Read-only MicroK8s API probe over existing SSH identity; no Fedora kubeconfig needed.
    try: host=foundation_host()
    except RuntimeError as e: return None,str(e)
    args=['ansible',host,*BASE,'-m','ansible.builtin.shell',
          '-a', 'microk8s kubectl '+shlex.join(command)+' 2>/dev/null']
    p=subprocess.run(args,capture_output=True,text=True,timeout=45)
    if p.returncode: return None,(p.stderr or p.stdout)[-350:]
    # Default Ansible oneline output includes host header followed by JSON.
    raw=p.stdout
    for marker in ('>>\n','>>\r\n'):
        if marker in raw:
            raw=raw.split(marker,1)[1]; break
    try: return json.loads(raw),None
    except ValueError: return None,'Kubernetes JSON parse unavailable (permissions or callback format). Use option 16.'


def restart_event_history(limit=10):
    """Read Kubernetes restart events without changing the journal."""
    path = STATE_DIR / 'pod-restarts' / 'events.json'

    if not path.exists():
        return []

    try:
        events = json.loads(path.read_text(encoding='utf-8'))
        if not isinstance(events, list):
            raise ValueError("Invalid event journal")
        if any(not isinstance(event, dict) for event in events):
            raise ValueError("Malformed event record")
        return events[-limit:]
    except (OSError, ValueError, TypeError) as exc:
        print("WARNING: Restart history unavailable:", exc)
        return None


def display_restart_events(limit=10):
    """Display historical Kubernetes restart events."""
    events = restart_event_history(limit)

    print("\nKUBERNETES RESTART EVENT HISTORY")

    if events is None:
        print("Restart event history could not be read.")
    elif not events:
        print("No recorded restart events.")
    else:
        for event in events:
            print(
                f"[{event.get('severity', 'WARN')}] "
                f"{event.get('timestamp', '?')} "
                f"{event.get('namespace', '?')}/{event.get('pod', '?')} "
                f"node={event.get('node', '?')} "
                f"container={event.get('container', '?')} "
                f"type={event.get('container_type', '?')} "
                f"new={event.get('new_restarts', '?')}"
            )

def alerts_and_snapshot(save=False):
    known,results=collect()
    if not known:
        print("WARNING: Infrastructure collection unavailable.")
        display_restart_events(limit=10)
        return
    alerts=[]
    summary={'checked_at':datetime.datetime.now(datetime.timezone.utc).isoformat(), 'hosts':{}}
    for host in known:
        d=results.get(host,{})
        if 'error' in d:
            alerts.append(('CRITICAL',f'{host}: SSH/status collection failed')); continue
        summary['hosts'][host]={'ip':d.get('ip'), 'cpu':d.get('cpu'), 'ram':d.get('ram'),
                                'disk':d.get('disk'),'temp':d.get('temp'),'updates':d.get('updates')}
        if d.get('disk') is not None and d['disk']>=90: alerts.append(('CRITICAL',f'{host}: disk {d["disk"]}%'))
        elif d.get('disk') is not None and d['disk']>=80: alerts.append(('WARN',f'{host}: disk {d["disk"]}%'))
        if d.get('temp') is not None and d['temp']>=85: alerts.append(('CRITICAL',f'{host}: temperature {d["temp"]}C'))
        elif d.get('temp') is not None and d['temp']>=75: alerts.append(('WARN',f'{host}: temperature {d["temp"]}C'))
        if d.get('ram') is not None and d['ram']>=90: alerts.append(('WARN',f'{host}: RAM {d["ram"]}%'))
        if d.get('reboot'): alerts.append(('WARN',f'{host}: reboot required'))
        if d.get('hostname')!=host: alerts.append(('WARN',f'{host}: hostname {d.get("hostname")} mismatch'))
    kubes=[(h,(results.get(h,{}) or {}).get('microk8s') or {}) for h in known]
    valid=[(h,k) for h,k in kubes if k.get('api')=='ok' and k.get('cluster_nodes') is not None]
    if not valid: alerts.append(('UNKNOWN','Kubernetes API monitoring unavailable'))
    else:
        h,k=max(valid,key=lambda item:item[1].get('cluster_nodes') or 0)
        summary['kubernetes']={'source':h,'ready':k.get('cluster_ready'),'total':k.get('cluster_nodes'),
                               'pods_healthy':k.get('pods_healthy'),'pods_total':k.get('pods_total'),
                               'ha':k.get('ha'),'masters':k.get('masters',[])}
        if k.get('cluster_ready') != k.get('cluster_nodes'):alerts.append(('CRITICAL','Kubernetes node NotReady'))
        if k.get('pods_healthy') != k.get('pods_total'):alerts.append(('WARN','Kubernetes pods not healthy'))
        if k.get('ha')!='yes' or len(k.get('masters') or [])<3: alerts.append(('CRITICAL','MicroK8s HA not verified'))
    status=BACKUP_DIR/'backup-status.json'
    if not status.exists(): alerts.append(('WARN','No backup-status.json found'))
    else:
        try:
            b=json.loads(status.read_text())
            age=(datetime.datetime.now(datetime.timezone.utc)-datetime.datetime.fromisoformat(b['checked_at'])).total_seconds()/3600
            if b.get('status')!='OK':alerts.append(('CRITICAL','Last backup not successful'))
            if age>36: alerts.append(('WARN',f'Last backup attempt {age:.1f}h old'))
            summary['backup_status']=b.get('status');summary['backup_age_hours']=round(age,2)
        except (ValueError,KeyError,OSError,TypeError):alerts.append(('WARN','Backup status unreadable'))
    summary['alerts']=[{'severity':sev,'message':msg} for sev,msg in alerts]
    print('\nACTIVE INFRASTRUCTURE ALERTS')
    if not alerts:print(color(' No threshold violations in current snapshot','32'))
    for sev,msg in alerts:print(color(f' [{sev}] {msg}','31' if sev=='CRITICAL' else '33'))
    if save:
        dest=STATE_DIR/'snapshots';dest.mkdir(parents=True,exist_ok=True,mode=0o700)
        fn=dest/(datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'.json')
        fd=os.open(str(fn),os.O_CREAT|os.O_EXCL|os.O_WRONLY,0o600)
        with os.fdopen(fd,'w') as f:json.dump(summary,f,indent=2)
        print('Saved private snapshot:',fn)

    display_restart_events(limit=10)

def backup_operations():
    while True:
        print('\nBACKUP OPERATIONS | 1 Status  2 Recent logs  3 Verify checksums  4 Backup now  0 Back')
        c=input('Choose: ').strip()
        if c=='0':return
        if c=='1':
            backup_health();run(['systemctl','list-timers','--all','microk8s-backup.timer'])
        elif c=='2':run(['journalctl','-u','microk8s-backup.service','-n','50','--no-pager'])
        elif c=='3':
            backup_dir=BACKUP_DIR/'dqlite'
            sums=sorted(backup_dir.glob('*.sha256'))
            if not sums:print('No SHA256 files to verify.');continue
            print(f'Checking {len(sums)} checksum files locally')
            for fn in sums:
                p=subprocess.run(['sha256sum','-c',fn.name],cwd=backup_dir)
                if p.returncode:print('FAILED:',fn)
        elif c=='4':
            if input('Type BACKUP NOW to trigger the configured Fedora service: ').strip()!='BACKUP NOW':continue
            # Authentication via polkit/sudo as required by local systemd.
            run(['sudo','systemctl','start','microk8s-backup.service'])
            run(['systemctl','status','microk8s-backup.service','--no-pager'])

