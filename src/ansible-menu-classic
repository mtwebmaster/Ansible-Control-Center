def add_inventory_host():
    """Safely append a host to an existing INI inventory group."""
    print('\nADD UBUNTU HOST — inventory registration')
    print(f'Inventory: {INV}')
    print('This updates only the Fedora inventory; it does not install Ubuntu or change the remote host.')
    if not INV.exists():
        print('Inventory file is missing.'); return
    original=INV.read_text()
    existing=inventory_hosts()
    groups=[]
    for line in original.splitlines():
        m=re.match(r'^\s*\[([A-Za-z0-9_.-]+)\]\s*(?:[#;].*)?$',line)
        if m and not m.group(1).endswith((':vars',':children')):
            groups.append(m.group(1))
    groups=list(dict.fromkeys(groups))
    if not groups:
        print('No regular [group] sections found. Create a group in hosts.ini first.');return
    print('Available inventory groups: '+', '.join(groups))
    default_group=next((g for g in groups if g in ('k3s_nodes','k3s','ubuntu','workers')),groups[0])
    group=input(f'Group [{default_group}]: ').strip() or default_group
    if group not in groups:
        print('Cancelled: group must already exist in hosts.ini.');return
    name=input('Inventory name (example node5): ').strip()
    if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_-]{0,62}',name):
        print('Invalid hostname. Use letters, numbers, hyphens, underscores.');return
    if name in existing or re.search(r'^\s*'+re.escape(name)+r'(?=\s|$)',original,re.M):
        print('This inventory name already exists; no changes made.');return
    ip=input('IPv4 address: ').strip()
    try:
        addr=ipaddress.ip_address(ip)
        if addr.version != 4 or addr.is_multicast or addr.is_unspecified:
            raise ValueError('Must be a usable IPv4 host address')
    except ValueError as e:
        print('Invalid IP:',e);return
    for oldname,params in existing.items():
        if str(params.get('ansible_host',oldname))==ip:
            print(f'IP address already used by {oldname}. No changes made.');return
    user=input('SSH username [supergimp]: ').strip() or 'supergimp'
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*',user):
        print('Invalid SSH username.');return
    print('Sudo executable: 1) Standard sudo  2) /usr/bin/sudo.ws (Ubuntu sudo-rs workaround)')
    sudo_choice=input('Choose [1]: ').strip() or '1'
    if sudo_choice not in ('1','2'):
        print('Invalid choice.');return
    extras=f' ansible_become_exe=/usr/bin/sudo.ws' if sudo_choice=='2' else ''
    entry=f'{name} ansible_host={ip} ansible_user={user}{extras}'
    print('\nProposed entry in ['+group+']:\n  '+entry)
    if input('Type ADD to save: ').strip() != 'ADD':
        print('Cancelled.');return
    # Insert immediately before the next inventory section to avoid writing into :vars.
    lines=original.splitlines(keepends=True)
    start=None
    for i,line in enumerate(lines):
        if re.match(r'^\s*\['+re.escape(group)+r'\]\s*(?:[#;].*)?$',line.rstrip('\r\n')):
            start=i;break
    if start is None:
        print('Target group disappeared; no changes made.');return
    end=next((i for i in range(start+1,len(lines)) if re.match(r'^\s*\[',lines[i])),len(lines))
    if end>0 and lines[end-1] and not lines[end-1].endswith('\n'):
        lines[end-1]+='\n'
    lines.insert(end,entry+'\n')
    stamp=datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    backup=INV.with_name(INV.name+'.bak-'+stamp)
    try:
        shutil.copy2(INV,backup)
        tmp=INV.with_name(INV.name+'.new')
        tmp.write_text(''.join(lines))
        tmp.chmod(INV.stat().st_mode & 0o777)
        test=subprocess.run(['ansible-inventory','-i',str(tmp),'--list'],capture_output=True,text=True)
        valid=False
        if test.returncode==0:
            try:
                hostvars=json.loads(test.stdout).get('_meta',{}).get('hostvars',{})
                valid=name in hostvars and hostvars[name].get('ansible_host')==ip
            except (ValueError,KeyError):pass
        if not valid:
            tmp.unlink(missing_ok=True)
            print('Inventory validation failed; original inventory is unchanged.')
            print((test.stderr or test.stdout)[-800:]);return
        os.replace(tmp,INV)
    except (OSError,ValueError) as e:
        print('Unable to update inventory:',e);return
    print(f'Added {name} to [{group}]. Backup: {backup}')
    if input('Install the existing Ansible public key on this host now? [y/N]: ').strip().lower()=='y':
        pub=Path(str(KEY)+'.pub')
        if not pub.exists():
            print(f'Public key not found: {pub}')
        else:
            print('You may be prompted for the remote Ubuntu account password.')
            run(['ssh-copy-id','-i',str(pub),'-o','IdentitiesOnly=yes','-o','IdentityAgent=none',
                 '-o','IdentityFile='+str(KEY),f'{user}@{ip}'])
    print(f'\nTest: ansible {name} -i {INV} --private-key {KEY} -m ping')
    if input('Run the Ansible ping test now? [Y/n]: ').strip().lower()!='n':
        adhoc(name,'ping')
    print('If SSH login is not ready, the host will appear unavailable until access is configured.')
    print('Run the k3s prerequisites playbook for the new node only after validating SSH and sudo.')

