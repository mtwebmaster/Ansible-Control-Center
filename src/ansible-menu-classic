            if target:
                ip=inventory_hosts().get(target,{}).get('ansible_host')
                if ip in CONTROL_IPS:
                    print('BLOCKED: control-plane upgrades require a separate quorum-aware workflow.')
                    target=None
                elif not acc_authorize_worker_target(target):
                    print('BLOCKED: unknown worker identity; use option 20.')
                    target=None
                else:
                    print('Generic update has no drain. Prefer option 20 for safe worker maintenance.')
            if target and input(f'Type UPDATE {target}: ').strip()==f'UPDATE {target}':
                adhoc(target,'ansible.builtin.apt','update_cache=yes upgrade=dist',True,True)
            else:print('Cancelled.')
            pause()
        elif c=='7':
            print('Disabled: whole-cluster upgrades can remove MicroK8s HA quorum. Use option 20 for workers.')
            pause()
        elif c=='8':
            target=target_prompt()
            if target:
                ip=inventory_hosts().get(target,{}).get('ansible_host')
                if ip in CONTROL_IPS: print('BLOCKED: control-plane reboot requires quorum-aware maintenance.')
                elif not acc_authorize_worker_target(target):print('BLOCKED: unrecognized worker; inspect inventory.')
                else:
                    print('Prefer option 20, which drains workloads and checks Ready state.')
                    if input(f'Type REBOOT {target} WITHOUT DRAIN: ').strip()==f'REBOOT {target} WITHOUT DRAIN':
                        adhoc(target,'ansible.builtin.reboot','reboot_timeout=900',True,True)
            pause()
        elif c=='9':
            if PLAYBOOK.exists():run(['ansible-playbook',*BASE,str(PLAYBOOK),'--ask-become-pass'])
            else:print('Missing playbook:',PLAYBOOK)
            pause()
        elif c=='10':kube_menu();pause()
        elif c=='11':diagnostics();pause()
        elif c=='12':
            run(['ansible-inventory','-i',str(INV),'--graph'])
            dashboard();pause()
        elif c=='13':show_history();pause()
        elif c=='14':show_help();pause()
        elif c=='15':add_inventory_host();pause()
        elif c=='16':microk8s_audit();pause()
        elif c=='17':fix_node1_alias();pause()
        elif c=='18':
            backup_health()
            run(['systemctl','status','microk8s-backup.timer','--no-pager'])
            run(['journalctl','-u','microk8s-backup.service','-n','25','--no-pager'])
            pause()
        elif c=='19':alerts_and_snapshot(save=True);pause()
        elif c=='20':worker_maintenance();pause()
        elif c=='21':backup_operations();pause()
        elif c=='22':workload_views();pause()
        elif c=='23':security_audit();pause()
        elif c=='24':preflight_report();pause()
        elif c=='25':history_snapshots();pause()
        elif c in EXTENDED_MENU:
            EXTENDED_MENU[c]();pause()
        elif c=='0':return
        else:print('Invalid selection.')

if __name__=='__main__':
    if len(sys.argv)>1 and sys.argv[1]=='--version':
        print(ACC_VERSION)
        sys.exit(0)
    if not INV.exists() or not KEY.exists():
        sys.exit(f'Missing inventory or key: {INV} / {KEY}')
    arg=sys.argv[1] if len(sys.argv)>1 else ''
    try:
        if arg=='--version':print(ACC_VERSION)
        elif arg=='--status':command_dashboard()
        elif arg=='--details':dashboard(details=True)
        elif arg=='--alerts':alerts_and_snapshot(save=False)
        elif arg=='--help':show_help()
        elif arg=='':menu()
        else:print('Usage: ansible-menu [--status|--details|--alerts|--version|--help]');sys.exit(2)
    except (KeyboardInterrupt,EOFError):print('\nExiting.')
