def safe_capture(argv, timeout=16):
    try:
        p=subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
        return p.returncode, p.stdout.strip(), p.stderr.strip()[:240]
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, '', str(exc)[:240]

def kube_json(args):
    code, output, error=safe_capture(['kubectl','--request-timeout=8s',*args,'-o','json'],25)
    if code:
        print('Kubernetes query unavailable:',error or 'exit '+str(code))
        return None
    try:return json.loads(output)
    except ValueError:
        print('Kubernetes response is not JSON');return None

