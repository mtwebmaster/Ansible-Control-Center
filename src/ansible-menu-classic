def inventory_hosts():
    p=subprocess.run(['ansible-inventory','-i',str(INV),'--list'],capture_output=True,text=True)
    try:
        d=json.loads(p.stdout)
        return {k:v for k,v in d.get('_meta',{}).get('hostvars',{}).items()}
    except (ValueError,KeyError): return {}

def hosts():
    p=subprocess.run(['ansible','all',*BASE,'--list-hosts'],capture_output=True,text=True)
    if p.returncode:
        print(p.stderr or p.stdout)
        return []
    return [s.strip() for s in p.stdout.splitlines()[1:] if s.strip()]

def parse_ansible_status_output(output, known):
    """Parse marked base64 payloads; never infer SSH failure from a parse error."""
    results = {}
    for host in known:
        # Ansible one-line output changes slightly across core versions:
        # host | CHANGED | rc=0 | (stdout) >> ACC_JSON_B64=...
        # Match on the explicit marker rather than the callback's >> syntax.
        host_lines = [line for line in output.splitlines()
                      if re.match(r'^' + re.escape(host) + r'\s+\|', line)]
        entries = '\n'.join(host_lines)
        marker = re.search(r'ACC_JSON_B64=([A-Za-z0-9+/=]+)', entries)
        if marker:
            try:
                decoded = base64.b64decode(marker.group(1), validate=True).decode('utf-8')
                item = json.loads(decoded)
                if isinstance(item, dict):
                    results[host] = item
                else:
                    results[host] = {'error': 'Remote returned unexpected data type'}
            except (ValueError, UnicodeDecodeError, json.JSONDecodeError) as exc:
                results[host] = {'error': 'Remote status decode failed: ' + str(exc)}
        elif 'UNREACHABLE!' in entries:
            results[host] = {'error': 'SSH unreachable: ' + entries[-160:]}
        elif 'FAILED!' in entries:
            results[host] = {'error': 'Status command failed: ' + entries[-160:]}
        else:
            results[host] = {'error': 'No status marker returned (check Ansible output)'}
    return results


def collect():
    known=hosts()
    if not known:return [],{}
    payload=base64.b64encode(REMOTE.encode()).decode()
    # The marker is deliberately outside the encoded JSON, allowing parsing
    # regardless of changes to Ansible's one-line callback layout.
    script=(f"printf ACC_JSON_B64=; "
            f"python3 -c 'exec(__import__(\"base64\").b64decode(\"{payload}\"))' | base64 -w0")
    print('\nGathering live status from inventory hosts...')
    p=subprocess.run(['ansible','all',*BASE,'-m','shell','-a',script,'-o','-f','15'],
                     capture_output=True,text=True)
    results=parse_ansible_status_output(p.stdout, known)
    if p.stderr and '--tree' in p.stderr:
        print('Note: an Ansible callback is still configured with deprecated --tree.')
    return known,results

def ha_summary(known, results):
    """Cluster-level data from accessible control-plane APIs; never infer HA from node count."""
    kubes=[]
    for host in known:
        data=results.get(host,{})
        kube=data.get('microk8s') or {}
        if kube.get('api')=='ok' and kube.get('cluster_nodes') is not None:
            kubes.append((host,kube))
    if not kubes:
        print(color(' CLUSTER: UNKNOWN (no authorized Kubernetes API query succeeded)', '33'))
        return
    # Prefer the fullest successful API response; if probes disagree, flag it.
    host,k=max(kubes,key=lambda hk:(hk[1].get('cluster_nodes') or 0, hk[1].get('pods_total') or 0))
    ready,total=k.get('cluster_ready'),k.get('cluster_nodes')
    healthy,pods=k.get('pods_healthy'),k.get('pods_total')
    has=[(h,x.get('ha'),x.get('masters',[])) for h,x in kubes if x.get('ha') is not None]
    verified=next(((h,v,m) for h,v,m in has if v=='yes' and len(m)>=3),None)
    if verified:
        ha='YES'; masters=f'{len(verified[2])} datastore masters'
    elif has:
        ha=' / '.join(sorted(set(x[1] for x in has)))
        masters='datastore members not confirmed'
    else:
        ha='UNKNOWN (insufficient permissions)'; masters='not verified'
    issues=[]
    if ready is not None and total is not None and ready!=total:issues.append(f'{total-ready} node(s) NotReady')
    if pods is not None and healthy is not None and healthy!=pods:issues.append(f'{pods-healthy} pod(s) not Running/Succeeded')
    if ha!='YES':issues.append('HA not verified' if ha.startswith('UNKNOWN') else 'HA not healthy/confirmed')
    if total!=5:issues.append(f'expected 5 nodes, saw {total}')
    mismatches=[h for h in known if 'error' not in results.get(h,{}) and results[h].get('hostname')!=h]
    if mismatches:issues.append('inventory name mismatch: '+', '.join(mismatches))
    unreachable=[h for h in known if 'error' in results.get(h,{})]
    if unreachable:issues.append('collection errors: '+', '.join(unreachable))
    disagreements=[h for h,x in kubes if x.get('cluster_nodes')!=total or x.get('cluster_ready')!=ready]
    if disagreements:issues.append('API results inconsistent: '+', '.join(disagreements))
    print(' MICROK8S CLUSTER HEALTH (queried via '+host+')')
    print(f' Nodes: {ready}/{total} Ready  |  Pods: {healthy if healthy is not None else "?"}/{pods if pods is not None else "?"} Running/Succeeded  |  HA: {ha}  |  {masters}')
    if issues:
        print(color(' ALERTS: ' + '; '.join(issues), '33'))
    else:
        print(color(' HEALTHY: no issues detected in collected snapshot', '32'))
    print(' Note: API access and quorum may change; verify failover separately.')

def backup_health():
    path = Path(expand_path(load_config()['backups']['directory']))
    if not path.exists():
        print(' BACKUP: NOT CONFIGURED / no verified scheduled run yet')
        return
    try:
        v=json.loads(path.read_text())
        checked=datetime.datetime.fromisoformat(v['checked_at'])
        age=datetime.datetime.now(datetime.timezone.utc)-checked
        hours=max(0,age.total_seconds()/3600)
        state=v.get('status','unknown').upper()
        archive=Path(v.get('archive',''))
        if state=='OK' and (not archive.is_file() or not Path(str(archive)+'.sha256').is_file()):
            state='MISSING FILE'
        if state=='OK' and hours>36:
            state='STALE'
        size=f'{archive.stat().st_size/1024:.0f} KiB' if archive.is_file() else '-'
        col='32' if state=='OK' else '33'
        print(' BACKUP: '+color(state,col)+f' | {hours:.1f}h since last attempt | {size} | {archive.name if archive.is_file() else "-"}')
        if state!='OK': print(' BACKUP ALERT: '+v.get('message','Check backup service logs'))
    except (OSError,ValueError,KeyError,TypeError) as e:
        print(' BACKUP: STATUS ERROR ('+str(e)+')')

