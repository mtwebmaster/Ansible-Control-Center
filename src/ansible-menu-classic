def pod_analysis():
    """Run restart analysis with exclusive single-writer protection."""
    import fcntl

    lock_dir = STATE_DIR / 'pod-restarts'
    lock_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_dir.chmod(0o700)

    lock_path = lock_dir / '.analysis.lock'

    with open(lock_path, 'a+', encoding='utf-8') as lock:
        os.chmod(lock_path, 0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Restart analysis already running; no changes made.")
            return

        return _pod_analysis_locked()

def _pod_analysis_locked():
    """Read-only Kubernetes restart analysis with local snapshot history."""
    import tempfile

    print("\nKUBERNETES POD RESTART ANALYSIS — v6.2")
    data = kube_json(['get', 'pods', '-A'])
    if data is None:
        print("No snapshot saved: Kubernetes API unavailable.")
        return

    # Reject invalid or incomplete Kubernetes list responses.
    if not isinstance(data, dict) or not isinstance(data.get('items'), list):
        print("BLOCKED: Invalid Kubernetes pod list; baseline preserved.")
        return

    if not data['items']:
        print("BLOCKED: Empty Kubernetes pod list; baseline preserved.")
        return

    if (data.get('metadata') or {}).get('continue'):
        print("BLOCKED: Paginated result; baseline preserved.")
        return

    folder = STATE_DIR / 'pod-restarts'
    snapshot = folder / 'latest.json'

    previous = None
    if snapshot.exists():
        try:
            previous = json.loads(snapshot.read_text(encoding='utf-8'))
            if not isinstance(previous.get('containers'), dict):
                raise ValueError("Invalid snapshot structure")
        except (OSError, ValueError, TypeError) as exc:
            print("Snapshot invalid; refusing to overwrite:", exc)
            return

    old = previous['containers'] if previous else {}
    current = {}
    rows = []
    total_main = 0
    total_init = 0
    total_new_main = 0
    total_new_init = 0
    restart_alerts = []
    restart_transitions = []

    for pod in data.get('items', []):
        meta = pod.get('metadata') or {}
        status = pod.get('status') or {}

        ns = meta.get('namespace', '?')
        name = meta.get('name', '?')
        uid = meta.get('uid')
        node_name = (pod.get('spec') or {}).get('nodeName', '?')
        phase = status.get('phase', 'Unknown')

        if not uid:
            print("Missing pod UID; snapshot not saved:", ns, name)
            return

        counts = {'main': 0, 'init': 0}
        deltas = {'main': 0, 'init': 0}
        problems = []

        for kind, field in (
            ('main', 'containerStatuses'),
            ('init', 'initContainerStatuses')
        ):
            for container in status.get(field) or []:
                cname = container.get('name', '?')
                count = int(container.get('restartCount') or 0)
                key = json.dumps([uid, kind, cname])

                current[key] = count
                counts[kind] += count

                # A new UID/container starts a new measurement baseline.
                if key in old:
                    delta = count - int(old[key])
                    if delta > 0:
                        deltas[kind] += delta
                        restart_transitions.append({
                            'uid': uid,
                            'namespace': ns,
                            'pod': name,
                            'node': node_name,
                            'container_type': kind,
                            'container': cname,
                            'previous_count': int(old[key]),
                            'current_count': count,
                            'new_restarts': delta
                        })

                waiting = (container.get('state') or {}).get('waiting')
                if waiting:
                    reason = waiting.get('reason', 'Unknown')
                    problems.append(f"{kind}:{cname}:{reason}")
                elif (
                    kind == 'main'
                    and phase == 'Running'
                    and not container.get('ready', False)
                ):
                    problems.append(f"main:{cname}:NotReady")

        if previous is not None:
            for kind in ('main', 'init'):
                if deltas[kind] > 0:
                    restart_alerts.append({
                        'severity': 'WARN',
                        'node': node_name,
                        'pod': f"{ns}/{name}",
                        'container_type': kind,
                        'new_restarts': deltas[kind],
                        'message': (
                            f"{ns}/{name} on {node_name}: "
                            f"{deltas[kind]} new {kind} container restart(s)"
                        )
                    })

        total_main += counts['main']
        total_init += counts['init']
        total_new_main += deltas['main']
        total_new_init += deltas['init']

        if phase not in ('Running', 'Succeeded'):
            problems.append(f"Pod:{phase}")

        rows.append({
            'name': f"{ns}/{name}",
            'node': node_name,
            'phase': phase,
            'main': counts['main'],
            'init': counts['init'],
            'new_main': deltas['main'],
            'new_init': deltas['init'],
            'problems': problems
        })

    print("Pods analyzed:", len(rows))
    print("Main-container restart total:", total_main)
    print("Init-container restart total:", total_init)

    if previous is None:
        print("Historical comparison: INITIAL BASELINE")
    else:
        print("Previous snapshot:", previous.get('captured_at', '?'))
        print("New main-container restarts:", total_new_main)
        print("New init-container restarts:", total_new_init)

    print("\nPOD DETAILS")
    print("-" * 100)

    rows.sort(
        key=lambda r: (
            r['new_main'] + r['new_init'],
            len(r['problems']),
            r['main'] + r['init']
        ),
        reverse=True
    )

    for row in rows:
        print(f"{row['name']} | node={row['node']}")
        print(
            f"  phase={row['phase']} "
            f"main={row['main']} init={row['init']} "
            f"new_main={row['new_main']} new_init={row['new_init']}"
        )
        for problem in row['problems']:
            print("  ALERT:", problem)

    print("\nNEW RESTART ALERTS")
    if restart_alerts:
        for alert in restart_alerts:
            print(f"  [{alert['severity']}] {alert['message']}")
    else:
        print("  No new restart increases detected.")

    # Durable event history. Event IDs prevent duplicate records
    # after retries or interrupted baseline updates.
    import hashlib

    journal = folder / 'events.json'

    try:
        if journal.exists():
            events = json.loads(journal.read_text(encoding='utf-8'))
            if not isinstance(events, list):
                raise ValueError("Invalid event journal")
        else:
            events = []
    except (OSError, ValueError, TypeError) as exc:
        print("BLOCKED: Restart event journal unavailable:", exc)
        return

    existing_ids = {
        event.get('id')
        for event in events
        if isinstance(event, dict)
    }

    timestamp = datetime.datetime.now(
        datetime.timezone.utc
    ).isoformat()

    new_events = []

    for transition in restart_transitions:
        identity = json.dumps(
            [
                transition['uid'],
                transition['container_type'],
                transition['container'],
                transition['previous_count'],
                transition['current_count']
            ],
            separators=(',', ':')
        )

        event_id = hashlib.sha256(identity.encode()).hexdigest()

        if event_id not in existing_ids:
            new_events.append({
                'id': event_id,
                'timestamp': timestamp,
                'severity': 'WARN',
                **transition
            })
            existing_ids.add(event_id)

    if new_events:
        journal_record = events + new_events
        folder.mkdir(parents=True, exist_ok=True, mode=0o700)

        import tempfile
        fd, temporary = tempfile.mkstemp(
            prefix='.events-',
            suffix='.tmp',
            dir=folder
        )

        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as stream:
                json.dump(journal_record, stream, indent=2)
                stream.flush()
                os.fsync(stream.fileno())

            os.chmod(temporary, 0o600)
            os.replace(temporary, journal)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

        print("Restart events recorded:", len(new_events))

    record = {
        'schema': 1,
        'captured_at': datetime.datetime.now(
            datetime.timezone.utc
        ).isoformat(),
        'containers': current,
        'alerts': restart_alerts
    }

    try:
        folder.mkdir(parents=True, exist_ok=True, mode=0o700)
        folder.chmod(0o700)

        fd, temporary = tempfile.mkstemp(
            prefix='.pod-restarts-',
            suffix='.tmp',
            dir=folder
        )
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as stream:
                json.dump(record, stream, indent=2)
                stream.flush()
                os.fsync(stream.fileno())

            os.chmod(temporary, 0o600)
            os.replace(temporary, snapshot)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

        print("\nSnapshot saved:", snapshot)
    except OSError as exc:
        print("WARNING: Could not save restart snapshot:", exc)

    print(
        "Note: new counts represent changes since the last "
        "successful snapshot, not necessarily new incidents."
    )

