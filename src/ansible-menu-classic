def kube_status():
    # Read-only local service and process detection; does not require sudo.
    installed = bool(cmd(['snap','list','microk8s'],5))
    if not installed:
        return {'role':'not installed','service':'-', 'api':'-', 'cluster_ready':None, 'cluster_nodes':None, 'pods_healthy':None, 'pods_total':None, 'ha':None}
    active = service('snap.microk8s.daemon-kubelite')
    if active != 'active':
        return {'role':'stopped','service':active,'api':'-', 'cluster_ready':None,'cluster_nodes':None,'pods_healthy':None,'pods_total':None,'ha':None}
    result={'role':'MicroK8s','service':active,'api':'restricted','cluster_ready':None,'cluster_nodes':None,'pods_healthy':None,'pods_total':None,'ha':None}
    # Attempt unprivileged API access only. Many installations restrict this
    # to the microk8s group; no sudo prompt in the SSH-login dashboard.
    try:
        p=subprocess.run(['microk8s','kubectl','get','nodes','-o','json','--request-timeout=4s'],capture_output=True,text=True,timeout=7)
        if p.returncode==0:
            items=json.loads(p.stdout).get('items',[])
            result['cluster_nodes']=len(items)
            result['cluster_ready']=sum(any(c.get('type')=='Ready' and c.get('status')=='True' for c in x.get('status',{}).get('conditions',[])) for x in items)
            result['api']='ok'
            q=subprocess.run(['microk8s','kubectl','get','pods','-A','-o','json','--request-timeout=4s'],capture_output=True,text=True,timeout=7)
            if q.returncode==0:
                pods=json.loads(q.stdout).get('items',[])
                result['pods_total']=len(pods)
                result['pods_healthy']=sum(x.get('status',{}).get('phase') in ('Running','Succeeded') for x in pods)
    except Exception:pass
    # HA from microk8s status can be accessed only if user is permitted.
    try:
        h=subprocess.run(['microk8s','status','--wait-ready'],capture_output=True,text=True,timeout=7)
        if h.returncode==0:
            result['masters']=[]
            for line in h.stdout.splitlines():
                if line.strip().startswith('high-availability:'):
                    result['ha']=line.split(':',1)[1].strip()
                if line.strip().startswith('datastore master nodes:'):
                    result['masters']=line.split(':',1)[1].strip().split()
    except Exception:pass
    return result

