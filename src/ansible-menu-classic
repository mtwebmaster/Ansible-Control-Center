    except Exception: return ''

def mem():
    d={}
    try:
        for line in open('/proc/meminfo'):
            k,v=line.split(':',1); d[k]=int(v.split()[0])
        return round((d['MemTotal']-d['MemAvailable'])/d['MemTotal']*100)
    except Exception: return None

def cpu():
    def tick():
        a=list(map(int,open('/proc/stat').readline().split()[1:]))
        return sum(a),a[3]+a[4]
    try:
        t1,i1=tick(); time.sleep(0.25); t2,i2=tick()
        return round(100*(1-(i2-i1)/(t2-t1))) if t2>t1 else 0
    except Exception: return None

def temp():
    vals=[]
    for p in glob.glob('/sys/class/hwmon/hwmon*/temp*_input'):
        try:
            value=int(open(p).read())/1000
            if 5<=value<=110: vals.append(value)
        except Exception: pass
    if not vals:
        for p in glob.glob('/sys/class/thermal/thermal_zone*/temp'):
            try:
                value=int(open(p).read())/1000
                if 5<=value<=110: vals.append(value)
            except Exception: pass
    return round(max(vals)) if vals else None

