# v5.1: presentation-only upgrade. All existing commands and protections remain.
def command_dashboard():
    """v5.2: node gauges, heuristic health scores, and local activity feed."""
    known, results = collect()
    if not known:
        return
    width = min(132, max(76, shutil.get_terminal_size(fallback=(120, 30)).columns))
    compact = width < 105
    interior = width - 2

    def line(value='', tone=None):
        value = str(value).replace('\n', ' ')
        value = value[:interior-2]
        text = ' ' + value.ljust(interior-2) + ' '
        print('│' + (color(text, tone) if tone else text) + '│')

    def divider():
        print('├' + '─' * interior + '┤')

    def gauge(value, length=10):
        if not isinstance(value, (int, float)):
            return '[' + '?' * length + ']'
        v = max(0, min(100, float(value)))
        filled = int(round(length * v / 100))
        return '[' + '█' * filled + '░' * (length-filled) + ']'

    def n(value, suffix='%'):
        return '-' if not isinstance(value, (int, float)) else f'{value:.0f}{suffix}'

    def score(d):
        # Heuristic infrastructure score: NOT an uptime/SLA prediction.
        if 'error' in d:
            return 0
        result = 100
        for name, warning, critical, low, high in (
            ('cpu', 70, 90, 8, 18),
            ('ram', 75, 90, 8, 18),
            ('disk', 75, 90, 10, 23),
            ('temp', 70, 85, 8, 18),
        ):
            v=d.get(name)
            if isinstance(v,(float,int)):
                if v >= critical: result -= high
                elif v >= warning: result -= low
            else:
                result -= 3
        if d.get('reboot'): result -= 7
        if d.get('hostname') and d['hostname'] != d.get('inventory_alias',d['hostname']):
            pass  # Inventory mismatch is checked separately.
        return max(0,result)

    responsive=[]
    alerts=[]
    for host in known:
        d=results.get(host,{})
        if 'error' in d:
            alerts.append(('CRITICAL',host+' unreachable or status unavailable'))
            continue
        responsive.append(host)
        if d.get('hostname') != host:alerts.append(('WARN',host+' hostname mismatch'))
        if d.get('reboot'):alerts.append(('WARN',host+' reboot requested'))
        if isinstance(d.get('disk'),(int,float)) and d['disk'] >= 85:
            alerts.append(('CRITICAL',host+' disk at '+n(d['disk'])))
        if isinstance(d.get('ram'),(int,float)) and d['ram'] >= 90:
            alerts.append(('CRITICAL',host+' RAM at '+n(d['ram'])))
        if isinstance(d.get('temp'),(int,float)) and d['temp'] >= 80:
            alerts.append(('WARN',host+' temperature at '+n(d['temp'],'°C')))
    kubes=[(h,(results.get(h,{}).get('microk8s') or {})) for h in known]
    valid=[(h,k) for h,k in kubes if k.get('api') == 'ok' and k.get('cluster_nodes') is not None]
    selected=max(valid,key=lambda t: (t[1].get('cluster_nodes') or 0,t[1].get('pods_total') or 0)) if valid else None
    k=selected[1] if selected else {}
    ready,total=k.get('cluster_ready'),k.get('cluster_nodes')
    pods_ok,pods_total=k.get('pods_healthy'),k.get('pods_total')
    ha_sources=[v for _,v in valid if v.get('ha') == 'yes' and len(v.get('masters') or []) >= 3]
    masters=len(ha_sources[0].get('masters') or []) if ha_sources else 0
    ha=bool(ha_sources)
    if total is None:alerts.append(('UNKNOWN','Kubernetes API metrics unavailable'))
    elif ready != total:alerts.append(('CRITICAL','Kubernetes nodes NotReady'))
    if pods_total is not None and pods_ok != pods_total:alerts.append(('CRITICAL','Unhealthy Kubernetes pods'))
    if not ha:alerts.append(('CRITICAL','HA dqlite quorum not verified'))

    backup_path=Path(expand_path(load_config()['backups']['directory']))
    backup_state='NOT CONFIGURED'; backup_age='-'; backup_file='-';backup_size='-';backup_time=''
    if backup_path.is_file():
        try:
            record=json.loads(backup_path.read_text())
            bt=datetime.datetime.fromisoformat(record['checked_at'])
            if bt.tzinfo is None: bt=bt.replace(tzinfo=datetime.timezone.utc)
            age=max(0,(datetime.datetime.now(datetime.timezone.utc)-bt).total_seconds()/3600)
            backup_age=f'{age:.1f}h'; backup_time=bt.astimezone().strftime('%m-%d %H:%M')
            backup_state=str(record.get('status','UNKNOWN')).upper()
            archive=Path(record.get('archive') or '/nonexistent')
            if archive.is_file() and Path(str(archive)+'.sha256').is_file():
                backup_file=archive.name
                backup_size=f'{archive.stat().st_size/1024:.0f} KiB'
            elif backup_state == 'OK':backup_state='MISSING FILE'
            if backup_state == 'OK' and age > 36:backup_state='OVERDUE'
        except (OSError,ValueError,KeyError,TypeError):backup_state='STATUS ERROR'
    if backup_state != 'OK':alerts.append(('WARN','Backup '+backup_state))
    label='HEALTHY' if not alerts else ('DEGRADED' if not any(s=='CRITICAL' for s,_ in alerts) else 'ATTENTION')

    print('┌'+'─'*interior+'┐')
    line('ANSIBLE CONTROL CENTER  /  OPERATIONS OVERVIEW', '1;36')
    line('FEDORA-SERVER1  •  MicroK8s cluster  •  '+datetime.datetime.now().astimezone().strftime('%a %d %b %Y  %H:%M:%S %Z'))
    divider()
    headline=(f'HOSTS {len(responsive)}/{len(known)}  │  K8S {n(ready,"")}/{n(total,"")}  │  PODS {n(pods_ok,"")}/{n(pods_total,"")}  │  '
              f'HA {"3-MASTER" if ha else "UNVERIFIED"}  │  {label}')
    line(headline, '1;32' if label=='HEALTHY' else '1;33' if label=='DEGRADED' else '1;31')
    divider()
    line('NODE HEALTH  /  CPU and memory gauges represent live utilization', '1;36')
    if compact:
        line(f'{"NODE":<8} {"SCORE":>5} {"CPU":>5} {"CPU GAUGE":<12} {"RAM":>5} {"RAM GAUGE":<12} {"DISK":>5} {"TEMP":>5} {"UPD":>4}')
    else:
        line(f'{"NODE":<8} {"IP":<16} {"SCORE":>5} {"CPU":>5} {"CPU LOAD":<12} {"RAM":>5} {"RAM LOAD":<12} {"DISK":>5} {"TEMP":>6} {"UPD":>4} {"ROLE":<11}')
    line('─'*(interior-2))
    for host in sorted(known,key=lambda s:(int(re.search(r'\d+$',s).group()) if re.search(r'\d+$',s) else 999,s)):
        d=results.get(host,{})
        sc=score(d)
        ip=str(d.get('ip','-'))
        role=(d.get('microk8s') or {}).get('role','-')
        if compact:
            message=f'{host:<8} {sc:>5} {n(d.get("cpu")):>5} {gauge(d.get("cpu")):<12} {n(d.get("ram")):>5} {gauge(d.get("ram")):<12} {n(d.get("disk")):>5} {n(d.get("temp"),"C"):>5} {str(d.get("updates", "-")):>4}                        '
        else:
            message=f'{host:<8} {ip:<16} {sc:>5} {n(d.get("cpu")):>5} {gauge(d.get("cpu")):<12} {n(d.get("ram")):>5} {gauge(d.get("ram")):<12} {n(d.get("disk")):>5} {n(d.get("temp"),"C"):>6} {str(d.get("updates",                         "-")):>4} {role[:11]:<11}'
        line(message, '31' if sc<60 else '33' if sc<85 else None)
    line('Score /100 is a heuristic from host resource thresholds and reboot flags, not an SLA.')
    divider()
    line('BACKUP  /  off-node dqlite snapshot', '1;36')
    line(f'{backup_state:<15} Age {backup_age:<7} Archive {backup_size:<10} {backup_file}', '32' if backup_state=='OK' else '33')
    divider()
    line(f'ACTIVE ALERTS  /  {len(alerts)} finding(s)', '1;32' if not alerts else '1;33')
    if not alerts:line('No threshold violations in the current collected snapshot.')
    for severity,message in alerts[:3]:line(f'{severity:<8} {message}', '31' if severity=='CRITICAL' else '33')
    if len(alerts)>3:line(f'+ {len(alerts)-3} additional finding(s). See ansible-menu --alerts')
    divider()
    line('RECENT ACTIVITY  /  recorded local operations, not live Kubernetes events', '1;36')
    feed=[]
    # Source 1: existing command history, if present. Never display command args (may contain secrets).
    try:
        for item in HISTORY.read_text().splitlines()[-25:]:
            match=re.match(r'([^|]+)\s*\|\s*exit=(\d+)',item)
            if match:
                feed.append((match.group(1).strip(), 'Ansible command completed' if match.group(2)=='0' else 'Command exited '+match.group(2)))
    except OSError:pass
    # Source 2: backup status (a successful attempt is not the same as a restore test).
    if backup_time:feed.append((backup_time,'Backup status recorded: '+backup_state))
    for when,event in feed[-3:][::-1]:line(f' {when[:22]:<22} {event}')
    if not feed:line('No local activity records available.')
    divider()
    line('ansible-menu  full console  │  --alerts  detailed alerts  │  --details  hardware')
    line('Use option 22 for live Kubernetes events; failover and restoration require separate tests.')
    print('└'+'─'*interior+'┘')

