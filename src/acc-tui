            put(win, y, x, f"BACKUP: {bak['state']}  Age: {bak.get('age_hours') if bak.get('age_hours') is not None else '?'} h")
            put(win, y+1, x, f"Archive: {bak.get('archive','-')}  Restore: NOT VERIFIED", muted)
            put(win, height-7, x, 'CPU/memory requests are scheduling reservations, NOT actual utilization.', muted)
            put(win, height-6, x, 'No affinity, storage, topology, taints or full scheduler simulation.', muted)
            put(win, height-5, x, 'Backup status/archive presence never proves a successful restore.', muted)
    put(win, height-4, x, 'MAINTENANCE: OBSERVE ONLY — execution disabled in dev12.', muted)


def draw_backup(win, x, width, height, evidence, page, recovery=None):
    """Render cached on-disk evidence; never run backups, verification, or systemctl actions."""
    accent = curses.color_pair(1) | curses.A_BOLD
    muted = curses.color_pair(3)
    if evidence is None or evidence.get('loading'):
        put(win, 7, x, 'Reading local backup evidence (read-only)...', accent)
        return
    state = evidence.get('state', 'UNKNOWN')
    put(win, 6, x, f"BACKUP: {state}  |  RESTORE: NOT VERIFIED  |  ACTIONS DISABLED", accent)
    put(win, 7, x, 'Local dqlite datastore backup evidence | F5 Refresh', muted)
    tabs = '  '.join(f"[{i+1}:{name.upper()}]" if i == page else
                     f"{i+1}:{name}" for i, name in enumerate(BACKUP_PAGES))
    put(win, 9, x, tabs, accent)
    line(win, 10, x, width)
    if state in ('NOT_CONFIGURED', 'CONFIG_UNAVAILABLE', 'MOUNT_UNVERIFIED', 'UNSAFE_BACKUP_CONFIG'):
        put(win, 12, x, f"LOCAL BACKUP EVIDENCE: {state}", curses.A_BOLD)
        put(win, 14, x, 'Configure backups.directory and backups.mount_point in dev13 config.')
        put(win, 16, x, 'No assumptions about archives or mounted storage.', muted)
        put(win, height-5, x, 'Backup system status unknown; does not imply backups are absent.', muted)
        return
    if page == 0:
        put(win, 12, x, 'LATEST RECORDED BACKUP', accent)
        put(win, 14, x, f"Status: {state}   Last check: {evidence.get('checked_at') or 'UNKNOWN'}")
        age = evidence.get('age_hours')
        put(win, 15, x, f"Age: {age} hours  |  Freshness threshold: 36 hours")
        put(win, 17, x, f"Archive: {evidence.get('archive','-')}")
        size = evidence.get('archive_bytes')
        put(win, 18, x, f"Size: {size:,} bytes" if isinstance(size, int) else 'Size: unknown')
        put(win, 20, x, f"SHA256: {evidence.get('checksum','UNVERIFIED')}")
        put(win, 21, x, f"Recorded integrity: {evidence.get('producer_integrity','UNVERIFIED')}")
        put(win, 23, x, 'Producer checks are historical; use acc-backup-verify-dev14 for a live hash.', muted)
    elif page == 1:
        put(win, 12, x, f"RECENT ARCHIVES  ({evidence.get('archive_count',0)} matching archive(s))", accent)
        put(win, 14, x, 'NAME                                SIZE (bytes)   SIDECAR   MODIFIED (UTC)')
        for i, row in enumerate((evidence.get('archives') or [])[:max(0,height-22)]):
            put(win, 15+i, x, f"{row['name'][:36]:<36}{row['size_bytes']:<15}{'YES' if row['sidecar'] else 'NO':<10}{row['modified_utc']}")
        put(win, height-5, x, 'Archive presence and checksum sidecar do NOT establish restorability.', muted)
    elif page == 2:
        put(win, 12, x, 'BACKUP STORAGE', accent)
        disk = evidence.get('storage') or {}
        total = disk.get('total_bytes')
        free = disk.get('free_bytes')
        put(win, 14, x, f"Mounted backup volume: VERIFIED" if disk else 'Mounted backup volume: UNKNOWN')
        put(win, 16, x, f"Total: {total/1024**3:.2f} GiB" if isinstance(total,int) else 'Total: unknown')
        put(win, 17, x, f"Free: {free/1024**3:.2f} GiB" if isinstance(free,int) else 'Free: unknown')
        put(win, 18, x, f"Used: {disk.get('used_percent')}%" if disk else 'Used: unknown')
        put(win, 20, x, f"Recorded archive count: {evidence.get('archive_count',0)}")
        put(win, height-5, x, 'This observes filesystem space; it does not test recovery.', muted)
    elif page == 3:
        put(win, 12, x, 'BACKUP SCHEDULE', accent)
        schedule = evidence.get('schedule') or {}
        put(win, 14, x, f"Timer: {schedule.get('state', 'UNKNOWN')}")
        put(win, 16, x, f"Next trigger: {schedule.get('next', 'UNKNOWN')}")
        put(win, 18, x, f"Last trigger: {schedule.get('last', 'UNKNOWN')}")
        put(win, 20, x, 'Timer is read via systemctl show; ACC does not change it.', muted)
        put(win, 22, x, 'Verification of a successful restore remains outstanding.', curses.A_BOLD)
    elif page == 4:
        put(win, 12, x, 'RECOVERY READINESS  (OBSERVATION ONLY)', accent)
        recovery = recovery or {'state':'NOT_COLLECTED','restore':'NOT VERIFIED'}
        put(win, 14, x, f"Backup evidence: {recovery.get('state','UNKNOWN')}")
        put(win, 15, x, f"Archives observed: {recovery.get('archive_count','?')}  Recent 7d: {recovery.get('last_7_days','?')}")
        put(win, 16, x, f"Checksum sidecars observed: {recovery.get('sidecar_count','?')}  Missing: {recovery.get('missing_sidecars','?')}")
        put(win, 17, x, f"Oldest: {recovery.get('oldest','UNKNOWN')}")
        put(win, 18, x, f"Newest: {recovery.get('newest','UNKNOWN')}")
        put(win, 20, x, f"Retention evidence: {recovery.get('coverage','UNVERIFIED')}")
        put(win, 22, x, 'Manual read-only tar inspection: acc-recovery-check-dev14 --inspect', muted)
        put(win, 23, x, 'Independent SHA256: use acc-backup-verify-dev14 --verify', muted)
        put(win, 25, x, 'RESTORE NOT TESTED; no workload/PV recovery guarantee.', curses.A_BOLD)
    put(win, height-4, x, 'BACKUPS: OBSERVE ONLY — restore not verified; execution disabled.', muted)


def draw(stdscr, section, node_index, sidebar, data, k8s=None, kpage=0, kselected=0, kscroll=0, security=None, spage=0, maintenance=None, mpage=0, mselected=0, mscroll=0, backup_status=None, bpage=0, recovery=None):
    stdscr.erase()
    h, w = stdscr.getmaxyx()

    if h < 25 or w < 90:
        put(stdscr, 1, 2, "ACC requires at least 90 columns x 25 rows")
        put(stdscr, 3, 2, "Resize terminal or press Q to exit")
        stdscr.refresh()
        return

    accent = curses.color_pair(1) | curses.A_BOLD
    highlight = curses.color_pair(2) | curses.A_BOLD
    muted = curses.color_pair(3)

    put(stdscr, 0, 2, "ACC // INFRASTRUCTURE OPERATIONS", accent)
    put(stdscr, 0, w - 18, VERSION, muted)
    line(stdscr, 1, 0, w)

    sidebar_width = 27 if sidebar else 0
    x = sidebar_width + 3 if sidebar else 3
    content_width = w - x - 3

    if sidebar:
        stdscr.vline(2, 27, ord("|"), h - 5)
        put(stdscr, 3, 2, "SYSTEM NAVIGATION", accent)

        for i, name in enumerate(SECTIONS):
            style = highlight if i == section else 0
            put(stdscr, 5 + i * 2, 2, f"{i+1:02d}  {name}", style)

    put(stdscr, 3, x, SECTIONS[section].upper(), accent)
    line(stdscr, 4, x, content_width)

    run = data.get("run")
    nodes = data.get("nodes", [])
    node = nodes[node_index] if node_index < len(nodes) else None

    if section == 2:
        draw_kubernetes(stdscr, x, content_width, h, k8s, kpage, kselected, kscroll)

    elif section == 3:
        draw_security(stdscr, x, content_width, h, security, spage)

    elif section == 4:
        draw_maintenance(stdscr, x, content_width, h, maintenance, mpage, mselected, mscroll, k8s)

    elif section == 5:
        draw_backup(stdscr, x, content_width, h, backup_status, bpage, recovery)

    elif data.get("error"):
        put(stdscr, 6, x, "DATABASE: " + data["error"], curses.A_BOLD)

    elif section in (0, 1):
        if not run:
            put(stdscr, 6, x, "No monitoring snapshots available")
        else:
            age = age_minutes(run["ts"])
            fresh = age is not None and -1 <= age <= 15
            age_str = "UNKNOWN" if age is None else f"{max(0, age):.1f}m"

            put(stdscr, 6, x, "CLUSTER OVERVIEW", accent)
            put(
                stdscr, 8, x,
                f"HOSTS {run['hosts_ok']}/{run['hosts_total']}     "
                f"API {'YES' if run['cluster_api'] else 'NO'}     "
                f"OPEN INCIDENTS {len(data['incidents'])}     "
                f"AGE {age_str}",
            )
            put(
                stdscr, 9, x,
                "DATA STATUS: RECENT" if fresh else
                "DATA STATUS: STALE / UNKNOWN",
                accent if fresh else curses.A_BOLD,
            )

            if run["collector_error"]:
                put(stdscr, 10, x, "COLLECTOR: " + str(run["collector_error"]))

            put(stdscr, 12, x, "NODE MONITORING", accent)

            bar_width = max(10, min(30, (content_width - 62) // 2))
            cpu_col = x + 19
            ram_col = cpu_col + bar_width + 8
            disk_col = ram_col + bar_width + 8

            put(stdscr, 14, x, "HOST      STATE")
            put(stdscr, 14, cpu_col, "CPU")
            put(stdscr, 14, ram_col, "MEMORY")
            put(stdscr, 14, disk_col, "DISK   TEMP   UPDATES")

            for i, n in enumerate(nodes):
                y = 16 + i
                if y >= h - 15:
                    break

                style = highlight if i == node_index else 0
                status = "UP" if n["reachable"] else "DOWN"

                put(stdscr, y, x, f"{n['host']:<10}{status:<6}", style)
                put(stdscr, y, cpu_col, meter(n["cpu"], bar_width), style)
                put(stdscr, y, ram_col, meter(n["ram"], bar_width), style)

                put(
                    stdscr, y, disk_col,
                    f"{fmt(n['disk'], '%'):<7}"
                    f"{fmt(n['temp'], 'C', 0):<7}"
                    f"{n['updates'] if n['updates'] is not None else 'N/A'}",
                    style,
                )

            detail_y = max(24, 17 + len(nodes))
            if detail_y + 9 < h - 3 and node:
                line(stdscr, detail_y - 2, x, content_width)
                role = configured_node_role(node["host"])

                put(
                    stdscr, detail_y, x,
                    f"NODE INSPECTOR // {node['host']}     ROLE: {role}",
                    accent,
                )
                put(
                    stdscr, detail_y + 2, x,
                    f"CPU       {fmt(node['cpu'], '%'):<15}"
                    f"MEMORY    {fmt(node['ram'], '%')}",
                )
                put(
                    stdscr, detail_y + 3, x,
                    f"DISK      {fmt(node['disk'], '%'):<15}"
                    f"TEMP      {fmt(node['temp'], 'C', 0)}",
                )
                put(
                    stdscr, detail_y + 4, x,
                    f"REACHABLE {'YES' if node['reachable'] else 'NO':<12}"
                    f"REBOOT    {'YES' if node['reboot'] else 'NO' if node['reboot'] is not None else 'N/A'}",
                )
                put(
                    stdscr, detail_y + 5, x,
                    f"UPDATES   {node['updates'] if node['updates'] is not None else 'N/A'}",
                )
                put(
                    stdscr, detail_y + 7, x,
                    f"SAMPLE UTC {node['ts']}", muted,
                )

    elif section == 6:
        put(stdscr, 7, x, "CURRENT OPEN INCIDENTS", accent)
        if not data["incidents"]:
            put(stdscr, 9, x, "No open incidents in recorded monitoring data")
        for i, incident in enumerate(data["incidents"]):
            put(
                stdscr, 9 + i * 2, x,
                f"{incident['severity']}: {incident['message']}",
            )

    else:
        put(stdscr, 7, x, "Module under development", accent)
        put(stdscr, 9, x, "ACC v6.2 remains the production operations backend", muted)

    line(stdscr, h - 3, 0, w)
    help_text = ("K8S: O/N/P/W/E View  UP/DOWN Select  PgUp/PgDn  F5 Refresh  Q Exit"
                 if section == 2 else
                 "SEC: O/H/C/A View  1-4 Tabs  F5 Refresh  Q Exit"
                 if section == 3 else
                 "MAINT: O/N/P/H/L/E View  UP/DOWN Node  F5 Refresh  Q Exit"
                 if section == 4 else
                 "BACKUP: O/A/S/T/R View  1-5 Tabs  F5 Refresh  Q Exit"
                 if section == 5 else
                 "TAB Sidebar  LEFT/RIGHT Section  UP/DOWN Node  1-8 Jump  F5 Refresh  Q Exit")
    put(stdscr, h - 2, 2, help_text, accent)
    put(
        stdscr, h - 2, w - 12,
        datetime.datetime.now().strftime("%H:%M:%S"),
        muted,
    )
    stdscr.refresh()


def main(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)

    if curses.has_colors():
        curses.start_color()
        try:
            curses.use_default_colors()
            bg = -1
        except curses.error:
            bg = curses.COLOR_BLACK

        curses.init_pair(1, curses.COLOR_CYAN, bg)
        curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
        curses.init_pair(3, curses.COLOR_WHITE, bg)

    section = 0
    node_index = 0
    sidebar = True
    data = read_database()
    k8s = None
    kpage = 0
    kselected = 0
    kscroll = 0
    security = None
    spage = 0
    maintenance = None
    mpage = 0
    mselected = 0
    mscroll = 0
    backup_status = None
    bpage = 0
    recovery = None

    while True:
        nodes = data.get("nodes", [])
        node_index = min(node_index, max(0, len(nodes) - 1))

        if section == 2 and k8s is None:
            # Inform the operator before any network operation. No auto polling.
            draw(stdscr, section, node_index, sidebar, data,
                 {"loading": True}, kpage, kselected, kscroll)
            k8s = safe_collect()

        if section == 3 and security is None:
            draw(stdscr, section, node_index, sidebar, data, k8s, kpage,
                 kselected, kscroll, {"loading": True}, spage)
            if k8s is None:
                k8s = safe_collect()
            security = safe_security_collect(k8s)

        if section == 4 and maintenance is None:
            draw(stdscr, section, node_index, sidebar, data, k8s, kpage,
                 kselected, kscroll, security, spage, {"loading": True}, mpage)
            if k8s is None:
                k8s = safe_collect()
            if security is None:
                security = safe_security_collect(k8s)
            maintenance = safe_maintenance_collect(data, k8s, security)

        if section == 5 and backup_status is None:
            draw(stdscr, section, node_index, sidebar, data, backup_status={"loading": True})
            backup_status = collect_backup()
        if section == 5 and bpage == 4 and recovery is None:
            recovery = collect_recovery(backup_snapshot=backup_status)

        mrows = (maintenance or {}).get('nodes') or []
        mselected = max(0, min(mselected, len(mrows)-1))
        mvisible = max(1, stdscr.getmaxyx()[0] - 20)
        if mselected < mscroll:
            mscroll = mselected
        if mselected >= mscroll + mvisible:
            mscroll = mselected - mvisible + 1

        rows = k8s_page_rows(k8s, kpage)
        kselected = max(0, min(kselected, len(rows) - 1))
        visible = max(1, stdscr.getmaxyx()[0] - 18)
        if kselected < kscroll:
            kscroll = kselected
        if kselected >= kscroll + visible:
            kscroll = kselected - visible + 1
        draw(stdscr, section, node_index, sidebar, data, k8s, kpage, kselected, kscroll, security, spage, maintenance, mpage, mselected, mscroll, backup_status, bpage, recovery)

        key = stdscr.getch()

        if key in (ord("q"), ord("Q")):
            return
        elif key == 9:
            sidebar = not sidebar
        elif key == curses.KEY_RIGHT:
            section = (section + 1) % len(SECTIONS)
        elif key == curses.KEY_LEFT:
            section = (section - 1) % len(SECTIONS)
        elif key == curses.KEY_DOWN:
            if section == 2:
                kselected = min(kselected + 1, max(0, len(rows) - 1))
            elif section == 4:
                mselected = min(mselected + 1, max(0, len(mrows)-1))
            else:
                node_index = min(node_index + 1, max(0, len(nodes) - 1))
        elif key == curses.KEY_UP:
            if section == 2:
                kselected = max(0, kselected - 1)
            elif section == 4:
                mselected = max(0, mselected - 1)
            else:
                node_index = max(node_index - 1, 0)
        elif section == 2 and key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            step = max(1, stdscr.getmaxyx()[0] - 18)
            delta = step if key == curses.KEY_NPAGE else -step
            kselected = max(0, min(kselected + delta, max(0, len(rows) - 1)))
        elif section == 4 and key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            delta = mvisible if key == curses.KEY_NPAGE else -mvisible
            mselected = max(0, min(mselected + delta, max(0,len(mrows)-1)))
        elif section == 4 and key in (ord("o"), ord("n"), ord("p"), ord("h"), ord("l"), ord("e")):
            mpage = "onphle".index(chr(key))
            # Retain selected host while switching between node/preflight/plan views.
            if mpage in (0, 3):
                mscroll = 0
        elif section == 5 and key in (ord("o"), ord("a"), ord("s"), ord("t"), ord("r")):
            bpage = "oastr".index(chr(key))
        elif section == 5 and key in (ord("["), ord("]")):
            bpage = (bpage + (-1 if key == ord("[") else 1)) % len(BACKUP_PAGES)
        elif section == 4 and key in (ord("["), ord("]")):
            mpage = (mpage + (-1 if key == ord("[") else 1)) % len(MAINT_PAGES)
        elif section == 2 and key in (ord("o"), ord("n"), ord("p"), ord("w"), ord("e")):
            kpage = "onpwe".index(chr(key))
            kselected = kscroll = 0
        elif section == 3 and key in (ord("o"), ord("h"), ord("c"), ord("a")):
            spage = "ohca".index(chr(key))
        elif section == 3 and key in (ord("["), ord("]")):
            spage = (spage + (-1 if key == ord("[") else 1)) % len(SEC_PAGES)
        elif section == 2 and key in (ord("["), ord("]")):
            kpage = (kpage + (-1 if key == ord("[") else 1)) % len(K8S_PAGES)
            kselected = kscroll = 0
        elif ord("1") <= key <= ord("8"):
            # Inside K8s, 1..5 selects views; 6..8 still jumps sections.
            if section == 2 and key <= ord("5"):
                kpage = key - ord("1")
                kselected = kscroll = 0
            elif section == 3 and key <= ord("4"):
                spage = key - ord("1")
            elif section == 4 and key <= ord("6"):
                mpage = key - ord("1")
            elif section == 5 and key <= ord("5"):
                bpage = key - ord("1")
            else:
                section = key - ord("1")
        elif key in (curses.KEY_F5, ord("r"), ord("R")):
            data = read_database()
            backup_status = None
            recovery = None
            if section in (2, 3, 4):
                k8s = None
                security = None
                maintenance = None


if __name__ == "__main__":
    if not os.isatty(0) or not os.isatty(1):
        raise SystemExit("Interactive terminal required")
    curses.wrapper(main)
