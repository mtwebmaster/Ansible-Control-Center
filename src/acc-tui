    if snapshot is None:
        put(win, 7, x, "Waiting for Kubernetes status...")
        return
    if snapshot.get("loading"):
        put(win, 7, x, "Connecting to Kubernetes (read-only)...", accent)
        put(win, 9, x, "Using restricted monitor credentials by default.", muted)
        return

    if snapshot.get("error"):
        put(win, 7, x, "KUBERNETES: NO VERIFIED CONNECTION", curses.A_BOLD)
        put(win, 9, x, snapshot["error"])
        put(win, 12, x, "Default: restricted TokenRequest / read-only Kubernetes API")
        put(win, 14, x, "F5 Retry | ACC_K8S_BACKEND=kubectl (explicit opt-in)", muted)
        return

    nodes = snapshot.get("nodes") or []
    pods = snapshot.get("pods") or []
    ready_nodes = sum(bool(n.get("ready")) for n in nodes)
    healthy_pods = sum(bool(p.get("ready")) for p in pods)
    put(win, 6, x,
        f"API CONNECTED  |  NODES {ready_nodes}/{len(nodes)} READY  |  "
        f"PODS {healthy_pods}/{len(pods)} HEALTHY", accent)
    put(win, 7, x,
        f"BACKEND {snapshot.get('backend')}  VIA {snapshot.get('endpoint')}", muted)
    put(win, 8, x,
        f"COLLECTED {snapshot.get('collected_at')}  (manual refresh: F5)", muted)
    tabs = "  ".join(f"[{i+1}:{name.upper()}]" if i == page else
                     f"{i+1}:{name}" for i, name in enumerate(K8S_PAGES))
    put(win, 10, x, tabs, accent)
    line(win, 11, x, width)

    if page == 0:
        namespaces = snapshot.get("namespaces")
        deploys = snapshot.get("deployments")
        events = snapshot.get("events")
        put(win, 13, x, "CLUSTER SUMMARY", accent)
        put(win, 15, x, f"Control/worker nodes: {len(nodes)}; not ready: {len(nodes)-ready_nodes}")
        put(win, 16, x, f"Pods: {len(pods)}; not healthy: {len(pods)-healthy_pods}")
        put(win, 17, x, f"Namespaces: {len(namespaces) if namespaces is not None else 'RBAC denied'}")
        put(win, 18, x, f"Deployments: {len(deploys) if deploys is not None else 'RBAC denied'}")
        put(win, 19, x, f"Recent events available: {len(events) if events is not None else 'RBAC denied'}")
        ha = snapshot.get('ha') or {}
        state = ha.get('state', 'UNCHECKED')
        if state == 'MATCH':
            ha_line = (f"HA REPORTED: {ha['observed_voters']}/{ha['expected_voters']} "
                       f"voters match config; sample age {ha['age_minutes']:.0f}m")
        elif state == 'MISMATCH':
            ha_line = 'HA MISMATCH: reported voters differ from configured masters'
        else:
            ha_line = f'HA LIVE MEMBERSHIP: {state} (run external acc-ha-probe-dev6)'
        put(win, 20, x, ha_line)
        put(win, 21, x, 'HA observations do not independently verify quorum or failover.', muted)
        warning_y = 23
    else:
        rows = k8s_page_rows(snapshot, page)
        titles = {
            1: "STATE   ACC ROLE        NODE                         VERSION",
            2: "STATE     RESTART  NAMESPACE       POD",
            3: "READY   NAMESPACE       DEPLOYMENT",
            4: "TYPE      REASON             NAMESPACE       OBJECT / MESSAGE",
        }
        put(win, 12, x, titles[page], accent)
        max_y = height - 6
        visible = max(0, max_y - 13 + 1)
        if not rows:
            if page in (3, 4) and snapshot.get("deployments" if page == 3 else "events") is None:
                put(win, 14, x, "Not authorized by monitor RBAC; this view is unavailable")
            else:
                put(win, 14, x, "No records returned for this view")
        else:
            for i, record in enumerate(rows[scroll:scroll + visible], start=scroll):
                y = 13 + i - scroll
                if page == 1:
                    state = "READY" if record.get("ready") else "NOTREADY"
                    if record.get("unschedulable"):
                        state = "CORDONED" if record.get("ready") else "NOTREADY"
                    msg = f"{state:<9}{record.get('role', '-'):<16}{record.get('name', '-'):<29}{record.get('version', '-')}"
                elif page == 2:
                    state = "HEALTHY" if record.get("ready") else record.get("phase", "Unknown")
                    msg = (f"{state:<10}{record.get('restarts', 0):<9}"
                           f"{record.get('namespace', '-'):<16}{record.get('name', '-')}")
                elif page == 3:
                    msg = (f"{record.get('ready', 0)}/{record.get('desired', 0):<6}"
                           f"{record.get('namespace', '-'):<16}{record.get('name', '-')}")
                else:
                    msg = (f"{record.get('kind', '-'):<10}{record.get('reason', '-'):<19}"
                           f"{record.get('namespace', '-'):<16}{record.get('object', '-')} "
                           f"{record.get('message', '')}")
                put(win, y, x, msg, highlight if i == selected else 0)
            put(win, height - 5, x,
                f"Rows {scroll+1}-{min(len(rows), scroll+visible)} of {len(rows)}  "
                "UP/DOWN select  PgUp/PgDn scroll", muted)
        if page == 1 and height >= 27:
            ha = snapshot.get('ha') or {}
            info = ('Reported voters = operator-provided MicroK8s status, '
                    'not Kubernetes role labels')
