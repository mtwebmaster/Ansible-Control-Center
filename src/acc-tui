def configured_node_role(host):
    """Do not hard-code topology in the node inspector."""
    try:
        from acc_config import load_config
        config = load_config()
        cluster = config['microk8s']
        if host in cluster['masters']:
            return 'MASTER (CONFIGURED)'
        if host in cluster['workers']:
            return 'WORKER (CONFIGURED)'
    except Exception:
        pass
    return 'UNKNOWN (CHECK ACC_CONFIG)'


def read_database():
    data = {
        "run": None,
        "nodes": [],
        "incidents": [],
        "error": None,
    }

    try:
        if not DB.is_file():
            raise RuntimeError("Monitoring database unavailable")

        con = sqlite3.connect(
            f"file:{DB}?mode=ro", uri=True, timeout=2
        )
        con.row_factory = sqlite3.Row
        con.execute("PRAGMA query_only=ON")
        con.execute("BEGIN")

        run = con.execute(
            "SELECT ts, hosts_total, hosts_ok, cluster_api, "
            "collector_error FROM runs ORDER BY rowid DESC LIMIT 1"
        ).fetchone()

        if run:
            data["run"] = dict(run)
            rows = con.execute(
                "SELECT ts, host, cpu, ram, disk, temp, updates, "
                "reboot, reachable FROM samples WHERE ts=? ORDER BY host",
                (run["ts"],),
            ).fetchall()
            data["nodes"] = [dict(row) for row in rows]

        rows = con.execute(
            "SELECT severity, message, status, last_seen "
            "FROM incidents WHERE UPPER(status)='OPEN' "
            "ORDER BY last_seen DESC LIMIT 8"
        ).fetchall()

        data["incidents"] = [dict(row) for row in rows]
        con.close()

    except (sqlite3.Error, RuntimeError, OSError) as exc:
        data["error"] = str(exc)

    return data


def age_minutes(timestamp):
    try:
        ts = datetime.datetime.fromisoformat(timestamp)
        if ts.tzinfo is None:
            return None
        delta = datetime.datetime.now(
            datetime.timezone.utc
        ) - ts.astimezone(datetime.timezone.utc)
        return delta.total_seconds() / 60
    except (ValueError, TypeError, AttributeError):
        return None


def fmt(value, suffix="", precision=1):
    if value is None:
        return "N/A"
    try:
        return f"{float(value):.{precision}f}{suffix}"
    except (ValueError, TypeError):
        return "N/A"


def meter(value, width):
    width = max(4, width)
    if value is None:
        return "[" + "-" * width + "] N/A"

    try:
        number = max(0.0, min(100.0, float(value)))
        filled = round(number / 100 * width)
        return "[" + "#" * filled + "." * (width - filled) + "]"
    except (ValueError, TypeError):
        return "[" + "-" * width + "]"


def put(win, y, x, message, style=0):
    h, w = win.getmaxyx()
    if 0 <= y < h and 0 <= x < w - 1:
        try:
            win.addnstr(y, x, str(message), w - x - 1, style)
        except curses.error:
            pass


def line(win, y, x, width):
    h, w = win.getmaxyx()
    if 0 <= y < h and x < w:
        win.hline(y, x, ord("-"), max(0, min(width, w - x - 1)))


def k8s_page_rows(snapshot, page):
    if not snapshot:
        return []
    if page == 1:
        return snapshot.get("nodes") or []
    if page == 2:
        return snapshot.get("pods") or []
    if page == 3:
        return snapshot.get("deployments") or []
    if page == 4:
        return snapshot.get("events") or []
    return []


def draw_kubernetes(win, x, width, height, snapshot, page, selected, scroll):
